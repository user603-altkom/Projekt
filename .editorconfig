root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Pliki w dane/ to dane wejściowe - nie normalizować końców linii ani
# kodowania.
[dane/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
charset = unset

# Java tylko do czytania - nie narzucamy tu żadnego stylu.
[legacy-java/**]
indent_size = 4
