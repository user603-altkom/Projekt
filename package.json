{
  "name": "szkolenie-ai-rejestr-rozliczen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Repozytorium ćwiczeniowe do szkolenia z AI w pracy programisty. Dane syntetyczne.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "raport": "tsx src/reports/dailyReport.ts dane/wyciag_2026_08.csv",
    "doctor": "node scripts/doctor.mjs",
    "sql:setup": "node --no-warnings scripts/sql-setup.mjs",
    "sql:raport": "node --no-warnings scripts/sql-raport.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^7.0.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
